{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitfiddle.local/schemas/manifest-2.schema.json",
  "title": "bitfiddle Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "abi",
    "description",
    "deprecated",
    "latency_samples",
    "size",
    "state_version",
    "custom_state_schema",
    "parameters",
    "inputs",
    "outputs",
    "flavors",
    "bypass",
    "presets"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "$ref": "#/$defs/semver" },
    "abi": { "enum": ["wasm-2", "native-2"] },
    "description": { "type": "string" },
    "deprecated": { "type": "boolean" },
    "latency_samples": { "type": "integer", "minimum": 0 },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_units", "height_units"],
      "properties": {
        "width_units": { "type": "integer", "minimum": 4, "multipleOf": 4 },
        "height_units": { "type": "integer", "minimum": 4, "multipleOf": 4 }
      }
    },
    "state_version": { "type": "integer", "minimum": 1 },
    "custom_state_schema": { "type": "object" },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "inputs": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/port" }
    },
    "outputs": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/port" }
    },
    "flavors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/flavor" }
    },
    "bypass": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/identifier" }
    },
    "presets": {
      "type": "array",
      "items": { "$ref": "#/$defs/preset" }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "api"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "api": { "const": "ui-2" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "signal": {
      "enum": ["clock", "note", "audio", "control", "gate"]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "signal", "description", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "signal": { "$ref": "#/$defs/signal" },
        "description": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "default"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["number", "integer", "boolean", "enum"] },
        "default": {},
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "flavor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "inputs", "state"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string" },
        "inputs": { "type": "object" },
        "state": { "type": "object" }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string" },
        "state": { "type": "object" }
      }
    }
  }
}
